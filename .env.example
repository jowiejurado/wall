# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both are safe to expose in the browser; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Optional, for the GIF picker. Free key from https://developers.giphy.com → Create an App → API.
# Server-only (no NEXT_PUBLIC_), so it never reaches the browser.
GIPHY_API_KEY=
